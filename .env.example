# ── LLM Provider ────────────────────────────────────────────────────────
# Supported: openai (OpenRouter or native OpenAI), groq, mock
LLM_PROVIDER=openai

# ── OpenAI / OpenRouter ──────────────────────────────────────────────────
# For OpenRouter: base URL = https://openrouter.ai/api/v1, key starts with sk-or-v1-
# For native OpenAI: base URL = https://api.openai.com/v1, key starts with sk-
OPENAI_API_KEY=your_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# ── Groq (alternative provider) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./app.db

# ── Token limits ─────────────────────────────────────────────────────────
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=2000

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=ai-business-agent
DEBUG=true
