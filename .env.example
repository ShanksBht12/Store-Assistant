
# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: groq | openai | generic | mock
# 'generic' works with ANY OpenAI-compatible endpoint (OpenRouter, Ollama, Mistral, etc.)
LLM_PROVIDER=openai

# ── OpenAI / OpenRouter ───────────────────────────────────────────────────────
# For native OpenAI:  OPENAI_API_BASE=https://api.openai.com/v1
# For OpenRouter:     OPENAI_API_BASE=https://openrouter.ai/api/v1  (key starts sk-or-v1-)
OPENAI_API_KEY=your_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

# ── Generic — any OpenAI-compatible endpoint ─────────────────────────────────
# Use this to connect to OpenRouter, Ollama, Mistral, Together AI, etc.
# without changing any code. Just fill these three and set LLM_PROVIDER=generic.
#
# Examples:
#   OpenRouter + Claude:  GENERIC_API_BASE=https://openrouter.ai/api/v1
#                         GENERIC_MODEL=anthropic/claude-3-5-sonnet
#   Ollama (local):       GENERIC_API_BASE=http://localhost:11434/v1
#                         GENERIC_API_KEY=none
#                         GENERIC_MODEL=ollama/llama3.2
#   Mistral:              GENERIC_API_BASE=https://api.mistral.ai/v1
#                         GENERIC_MODEL=mistral/mistral-large-latest
GENERIC_API_KEY=
GENERIC_API_BASE=
GENERIC_MODEL=
# Optional extra headers as a JSON dict, e.g. for OpenRouter's required header:
# GENERIC_EXTRA_HEADERS={"HTTP-Referer":"http://localhost:8000","X-Title":"StyleStore"}
GENERIC_EXTRA_HEADERS=

# ── Per-request model override (router) ──────────────────────────────────────
# You can also override the model per chat request by sending:
#   {"message": "...", "model": "anthropic/claude-3-5-sonnet"}
# in the POST /api/chat body. No .env change needed for per-request switching.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./app.db

# ── Token limits ──────────────────────────────────────────────────────────────
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=2000

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ai-business-agent
DEBUG=true
